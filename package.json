{
  "name": "olive-rank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-capture.mjs && vite build && node scripts/dev.mjs",
    "dev:worker": "wrangler dev --ip 127.0.0.1",
    "build": "node scripts/build-capture.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply olive-rank --local",
    "setup:local": "node scripts/local-setup.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "verify:capture": "node scripts/verify-capture.mjs",
    "dev:services": "node scripts/dev.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "papaparse": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260201.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "linkedom": "^0.18.15",
    "miniflare": "^4.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
