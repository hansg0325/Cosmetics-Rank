{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["src", "tests", "*.ts", "extension"]
}
