{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cosmetics-rank-scheduler",
  "main": "src/scheduler/index.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "SCHEDULER_MODE": "collection" },
  "triggers": { "crons": ["0 21 * * *"] },
  "queues": {
    "producers": [{ "binding": "COLLECTION_QUEUE", "queue": "cosmetics-rank-collection" }]
  },
  "env": {
    "setup": {
      "name": "cosmetics-rank-scheduler",
      "vars": { "SCHEDULER_MODE": "setup" },
      "triggers": { "crons": [] },
      "queues": { "producers": [] }
    },
    "smoke": {
      "name": "cosmetics-rank-scheduler",
      "vars": { "SCHEDULER_MODE": "smoke" },
      "triggers": { "crons": ["*/5 * * * *"] },
      "queues": {
        "producers": [{ "binding": "COLLECTION_QUEUE", "queue": "cosmetics-rank-collection" }]
      }
    }
  }
}
